#
# Copy to vendor/azerothcore-wotlk/.env during bootstrap (or run scripts/bootstrap.sh).
# Values below are safe local defaults — change the DB password before exposing ports.
#

# --- AzerothCore Docker (from conf/dist/env.docker) ---
DOCKER_DB_ROOT_PASSWORD=changeme
DOCKER_DB_EXTERNAL_PORT=3306
DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_WORLD_EXTERNAL_PORT=8085
DOCKER_SOAP_EXTERNAL_PORT=7878

# Container user for built images. Use 1000:1000 on macOS (host gid 20 / staff
# collides with Ubuntu's dialout and breaks `docker compose build`).
# On Linux, bootstrap may set these to your uid/gid when both are >= 1000.
DOCKER_USER=acore
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000

# Client map data volume:
#   Leave default (named volume) to let ac-client-data-init download maps, OR
#   after scripts/pull-client-data.sh, set:
# DOCKER_VOL_DATA=./env/dist/data
DOCKER_VOL_DATA=ac-client-data

DOCKER_OLLAMA_EXTERNAL_PORT=11434

# --- Playerbots (16 GB–friendly defaults) ---
AC_AI_PLAYERBOT_MIN_RANDOM_BOTS=40
AC_AI_PLAYERBOT_MAX_RANDOM_BOTS=75
# 100/0 = Alliance-only random bots
AC_AI_PLAYERBOT_RANDOM_BOT_ALLIANCE_RATIO=100
AC_AI_PLAYERBOT_RANDOM_BOT_HORDE_RATIO=0
# Max bot level tracks highest online player + 3 (not a strict ±N band)
AC_AI_PLAYERBOT_SYNC_LEVEL_WITH_PLAYERS=1
AC_AI_PLAYERBOT_RANDOM_BOT_MIN_LEVEL=50
AC_AI_PLAYERBOT_RANDOM_BOT_MAX_LEVEL=80
AC_AI_PLAYERBOT_DISABLE_DEATH_KNIGHT_LOGIN=1
AC_MAP_UPDATE_THREADS=4

# --- mod-ollama-chat / Ollama ---
AC_OLLAMA_CHAT_MODEL=qwen2.5:3b
AC_OLLAMA_CHAT_URL=http://ac-ollama:11434/api/generate
AC_OLLAMA_CHAT_DEBUG_ENABLED=0

# Host Ollama example (macOS Metal / Linux host install):
# AC_OLLAMA_CHAT_URL=http://host.docker.internal:11434/api/generate
