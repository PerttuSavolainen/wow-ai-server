# Starter notes for module config (applied primarily via docker-compose env vars).
# After first start, AzerothCore also writes .conf.dist files under env/dist/etc/modules/.
# Prefer env vars in .env / docker-compose.override.yml for Docker setups.

# Playerbots (env equivalents used by compose):
#   AiPlayerbot.Enabled                  -> AC_AI_PLAYERBOT_ENABLED
#   AiPlayerbot.EnableBroadcasts         -> AC_AI_PLAYERBOT_ENABLE_BROADCASTS
#   AiPlayerbot.RandomBotAutologin       -> AC_AI_PLAYERBOT_RANDOM_BOT_AUTOLOGIN
#   AiPlayerbot.MinRandomBots            -> AC_AI_PLAYERBOT_MIN_RANDOM_BOTS
#   AiPlayerbot.MaxRandomBots            -> AC_AI_PLAYERBOT_MAX_RANDOM_BOTS
#
# Recommended on ~16 GB RAM hosts:
#   MinRandomBots = 20
#   MaxRandomBots = 50
#
# worldserver.conf:
#   MapUpdate.Threads = 4   (-> AC_MAP_UPDATE_THREADS)
