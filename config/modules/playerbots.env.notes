# Starter notes for module config (applied primarily via docker-compose env vars).
# After first start, AzerothCore also writes .conf.dist files under env/dist/etc/modules/.
# Prefer env vars in .env / docker-compose.override.yml for Docker setups.

# Playerbots (env equivalents used by compose):
#   AiPlayerbot.Enabled                      -> AC_AI_PLAYERBOT_ENABLED
#   AiPlayerbot.EnableBroadcasts             -> AC_AI_PLAYERBOT_ENABLE_BROADCASTS
#   AiPlayerbot.RandomBotAutologin           -> AC_AI_PLAYERBOT_RANDOM_BOT_AUTOLOGIN
#   AiPlayerbot.MinRandomBots                -> AC_AI_PLAYERBOT_MIN_RANDOM_BOTS
#   AiPlayerbot.MaxRandomBots                -> AC_AI_PLAYERBOT_MAX_RANDOM_BOTS
#   AiPlayerbot.RandomBotAllianceRatio       -> AC_AI_PLAYERBOT_RANDOM_BOT_ALLIANCE_RATIO
#   AiPlayerbot.RandomBotHordeRatio          -> AC_AI_PLAYERBOT_RANDOM_BOT_HORDE_RATIO
#   AiPlayerbot.SyncLevelWithPlayers         -> AC_AI_PLAYERBOT_SYNC_LEVEL_WITH_PLAYERS
#   AiPlayerbot.RandomBotMinLevel            -> AC_AI_PLAYERBOT_RANDOM_BOT_MIN_LEVEL
#   AiPlayerbot.RandomBotMaxLevel            -> AC_AI_PLAYERBOT_RANDOM_BOT_MAX_LEVEL
#   AiPlayerbot.DisableDeathKnightLogin      -> AC_AI_PLAYERBOT_DISABLE_DEATH_KNIGHT_LOGIN
#
# Recommended on ~16 GB RAM hosts:
#   MinRandomBots = 20
#   MaxRandomBots = 50
#
# Alliance-only PVE:
#   RandomBotAllianceRatio = 100
#   RandomBotHordeRatio = 0
#
# Level banding:
#   SyncLevelWithPlayers = 1 caps new/randomize max level at (highest online player + 3).
#   There is no built-in “exact ±5 of my character” slider; raise RandomBotMinLevel
#   manually if you want to drop very low-level bots as you outlevel starter zones.
#   Zone brackets still send bots to level-appropriate quest hubs (e.g. Dun Morogh 5–12).
#
# worldserver.conf:
#   MapUpdate.Threads = 4   (-> AC_MAP_UPDATE_THREADS)
#
# IMPORTANT: worldserver/db-import must be built from the Playerbots fork with
# modules present (NO_CACHE=1 ./scripts/up.sh). Stock docker.io/acore images
# have no playerbots and will never spawn bots.
