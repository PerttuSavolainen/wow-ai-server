# Starter notes for mod-ollama-chat (applied primarily via docker-compose env vars).
# Full defaults live in the module's mod_ollama_chat.conf.dist after build.

# OllamaChat.Enable        -> AC_OLLAMA_CHAT_ENABLE
# OllamaChat.DebugEnabled  -> AC_OLLAMA_CHAT_DEBUG_ENABLED
# OllamaChat.Model         -> AC_OLLAMA_CHAT_MODEL
# OllamaChat.Url           -> AC_OLLAMA_CHAT_URL

# Recommended models for ~16 GB RAM + optional 8 GB VRAM GPU:
#   qwen2.5:3b   (default)
#   llama3.2:3b
# Avoid 8B+ models until you have confirmed free RAM/VRAM headroom.

# In-compose Ollama:
#   AC_OLLAMA_CHAT_URL=http://ac-ollama:11434/api/generate
#
# Host Ollama (macOS Metal / host GPU):
#   AC_OLLAMA_CHAT_URL=http://host.docker.internal:11434/api/generate
